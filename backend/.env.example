# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas connection string)
# Notes for Render & Production:
# 1. Replace <username> and <password> with your MongoDB Atlas Database User credentials (remove the < and >).
# 2. Do NOT enclose the URI in quotation marks (" or ').
# 3. If your password contains special characters like @, #, %, +, &, URL-encode them or use an alphanumeric password.
# 4. Ensure target database name '/orbitly_studio' is in the URI path before the '?' query parameters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orbitly_studio?retryWrites=true&w=majority

# Frontend URL for CORS origin validation (without trailing slash)
CLIENT_URL=https://your-frontend-domain.example

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secure_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password
